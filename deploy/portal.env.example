# /etc/portal/portal.env — yayın ve yedek betiklerinin ortamı (chmod 600, sahibi portal).
# scripts/release.sh ve scripts/backup.sh bunu okur: `set -a; . /etc/portal/portal.env; set +a`.

# Kendi sunucumuzdaki Convex (Aşama 2'den sonra)
CONVEX_SELF_HOSTED_URL=https://api.portal.example.com
# docker compose exec backend ./generate_admin_key.sh
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Sunucu dışı yedek (Hetzner Storage Box, SSH portu 23)
BACKUP_REMOTE=uXXXXX@uXXXXX.your-storagebox.de:portal-backups/
BACKUP_REMOTE_PORT=23
