# /etc/planningexpert/portal.env — yayın ve yedek betiklerinin ortamı (chmod 600).
# Okuma: `set -a; . /etc/planningexpert/portal.env; set +a`.

# Kendi sunucumuzdaki Convex: CLI yerelden bağlanır, site Funnel adresini kullanır.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_PUBLIC_URL=https://planningexpert.tailXXXX.ts.net:8443
# docker compose exec backend ./generate_admin_key.sh  (sunucuda üretilir, mesajla paylaşılmaz)
# Tek tırnak içinde: anahtar `|` içerir, tırnaksız kabukta hata verir (ve anahtar günlüğe düşer).
CONVEX_SELF_HOSTED_ADMIN_KEY='…'

# Bu sunucuda testler çalıştırılmaz (bellek); yayın yalnızca CI'da yeşil commit'ten.
SKIP_LOCAL_VERIFY=1

# Sunucu dışı yedek (isteğe bağlı; ör. Hetzner Storage Box, SSH portu 23)
BACKUP_REMOTE=
BACKUP_REMOTE_PORT=23
