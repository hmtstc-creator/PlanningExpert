# /etc/caddy/Caddyfile — HTTPS (Let's Encrypt otomatik). Adlar kurulumda yazılır
# (deploy/README.md → Aşama 1: PORTAL_HOST, API_HOST). Sunucuda başka site
# varsa onların blokları bu dosyada kalır; bunlar eklenir.

PORTAL_HOST {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}

# Convex API ve WebSocket (Caddy WebSocket'i kendiliğinden taşır).
API_HOST {
	reverse_proxy 127.0.0.1:3210
}
