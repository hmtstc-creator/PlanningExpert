# Günlük yedek (planningexpert-backup.timer tetikler): scripts/backup.sh.
[Unit]
Description=PlanningExpert — daily Convex backup

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/planningexpert
EnvironmentFile=/etc/planningexpert/portal.env
# Yedekler veri içerir: dosyalar 600 oluşsun (varsayılan umask 644 verir).
UMask=0077
ExecStart=/opt/planningexpert/scripts/backup.sh
