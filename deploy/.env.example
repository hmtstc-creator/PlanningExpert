# deploy/.env — kopyala, doldur, `chmod 600`. Git'e girmez (.gitignore: .env).
# Sürümler kurulum günü sabitlenir (deploy/README.md → Aşama 2); güncelleme bilerek yapılır.
CONVEX_BACKEND_TAG=
CONVEX_DASHBOARD_TAG=
TAILSCALE_TAG=stable

INSTANCE_NAME=planningexpert
# openssl rand -hex 32
INSTANCE_SECRET=

# Funnel adresi + :8443 (ts kapsayıcısı açılınca belli olur: docker compose exec ts tailscale status --json → Self.DNSName)
CONVEX_PUBLIC_URL=https://planningexpert.tailXXXX.ts.net:8443

# Bellek sınırı (botları korumak için)
BACKEND_MEM=1200m
