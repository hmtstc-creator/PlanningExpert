# deploy/convex/.env — kopyala, doldur, `chmod 600`. Git'e girmez (.gitignore: .env).
# Sürümler kurulum günü sabitlenir (deploy/README.md → Aşama 2); güncelleme bilerek yapılır.
CONVEX_BACKEND_TAG=
CONVEX_DASHBOARD_TAG=
POSTGRES_TAG=17

INSTANCE_NAME=convex-self-hosted
# openssl rand -hex 32
INSTANCE_SECRET=
# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=convex_self_hosted

# Dışarıdan erişilen API adresi (Caddy → 127.0.0.1:3210)
CONVEX_CLOUD_ORIGIN=https://api.portal.example.com
